<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FlowIME.App</AssemblyName>
    <RootNamespace>FlowIME.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Brand\Generated\FlowIME.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="Assets\Brand\Generated\FlowIME.Mark.44.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Brand\Generated\FlowIME.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../LICENSE"
          Link="LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../FlowIME.Core/FlowIME.Core.csproj" />
    <ProjectReference Include="../FlowIME.Windows/FlowIME.Windows.csproj" />
    <ProjectReference Include="../FlowIME.Infrastructure/FlowIME.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!-- Windows App SDK 2.x does not currently add unpackaged app XBF/PRI
       resources to ResolvedFileToPublish. Without these files the published
       executable exits with 0xC000027B while loading XAML. -->
  <Target Name="CopyUnpackagedWinUiResourcesToPublish"
          AfterTargets="Publish"
          Condition="'$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUiPublishResource Include="$(OutputPath)**\*.xbf" />
      <_WinUiPublishResource Include="$(OutputPath)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUiPublishResource)"
          DestinationFiles="@(_WinUiPublishResource->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
