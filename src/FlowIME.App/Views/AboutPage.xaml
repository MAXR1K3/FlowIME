<Page
    x:Class="FlowIME.App.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        HorizontalContentAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="AboutStructureStates">
                <VisualState x:Name="CompactAboutStructure">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboutIdentity.(Grid.Row)" Value="1" />
                        <Setter Target="AboutIdentity.(Grid.Column)" Value="0" />
                        <Setter Target="AboutIdentity.(Grid.ColumnSpan)" Value="2" />
                        <Setter Target="AboutIdentity.Margin" Value="0,14,0,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="DesktopAboutStructure">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AboutIdentity.(Grid.Row)" Value="0" />
                        <Setter Target="AboutIdentity.(Grid.Column)" Value="1" />
                        <Setter Target="AboutIdentity.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="AboutIdentity.Margin" Value="0" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
            <VisualStateGroup x:Name="AboutSpacingStates">
                <VisualState x:Name="CompactAboutSpacing">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="PageContent.Padding" Value="16,20,16,28" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableAboutSpacing">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="760" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="PageContent.Padding" Value="24,24,24,32" /></VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideAboutSpacing">
                    <VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100" /></VisualState.StateTriggers>
                    <VisualState.Setters><Setter Target="PageContent.Padding" Value="32,28,32,40" /></VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <StackPanel x:Name="PageContent" MaxWidth="{StaticResource FlowSettingsContentMaxWidth}" Padding="16,20,16,28" Spacing="22" HorizontalAlignment="Stretch">


            <StackPanel Spacing="5">
                <TextBlock Text="关于" Style="{StaticResource FlowPageTitleStyle}" />
                <TextBlock
                    Text="FlowIME 是一个根据前台应用自动管理输入法与中文 / 英文状态的 Windows 工具。"
                    Style="{StaticResource FlowPageSubtitleStyle}" />
            </StackPanel>

            <Border Padding="24" Style="{StaticResource FlowCardStyle}">
                <Grid ColumnSpacing="18" RowSpacing="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="52"
                        Height="52"
                        CornerRadius="12"
                        Background="{ThemeResource AccentFillColorTertiaryBrush}">
                        <FontIcon
                            Glyph="&#xE765;"
                            FontSize="24"
                            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>
                    <StackPanel x:Name="AboutIdentity" Grid.Column="1" Spacing="5">
                        <TextBlock Text="FlowIME" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="UI/UX R3 Foundation · 基于 P8C.2 功能基线" Style="{StaticResource FlowMutedTextStyle}" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Text="应用规则、场景规则与游戏保护共同管理输入状态；所有处理都在本机完成。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="10">
                <TextBlock Text="隐私" Style="{StaticResource FlowSectionTitleStyle}" />
                <Border Padding="18" Style="{StaticResource FlowCardStyle}">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            Glyph="&#xE72E;"
                            FontSize="18"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            VerticalAlignment="Top"
                            Margin="0,2,0,0" />
                        <StackPanel Grid.Column="1" Spacing="3">
                            <TextBlock Text="仅处理窗口与输入状态" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock
                                Text="核心功能在本机完成，不读取键入内容、剪贴板或密码。"
                                Style="{StaticResource FlowMutedTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
