<ContentDialog
    x:Class="FlowIME.App.Views.GlobalDefaultDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="全局默认场景"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource FlowPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource FlowSecondaryButtonStyle}"
    CornerRadius="12"
    DefaultButton="Primary"
    HorizontalContentAlignment="Stretch">
    <ContentDialog.Resources><ResourceDictionary Source="ms-appx:///Themes/Brand.xaml" /></ContentDialog.Resources>


    <StackPanel x:Name="DialogRoot" MaxWidth="520" Spacing="16">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="CompactWidth">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="EnabledToggle.(Grid.Row)" Value="1" />
                        <Setter Target="EnabledToggle.(Grid.Column)" Value="0" />
                        <Setter Target="EnabledToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="EnabledToggle.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWidth">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="720" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DialogRoot.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="EnabledToggle.(Grid.Row)" Value="0" />
                        <Setter Target="EnabledToggle.(Grid.Column)" Value="1" />
                        <Setter Target="EnabledToggle.Margin" Value="0" />
                        <Setter Target="EnabledToggle.HorizontalAlignment" Value="Right" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Border Padding="14" Style="{StaticResource FlowInsetCardStyle}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon
                    Glyph="&#xE8FD;"
                    FontSize="18"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Top" />
                <StackPanel Grid.Column="1" Spacing="3">
                    <TextBlock Text="匹配优先级" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock
                        Text="1. 应用专属规则  →  2. 全局默认场景  →  3. 保持现状"
                        Style="{StaticResource FlowMutedTextStyle}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnSpacing="12" RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="3">
                <TextBlock Text="启用全局默认" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock
                    Text="关闭后，没有应用规则匹配时 FlowIME 不会主动改变输入法或输入状态。"
                    Style="{StaticResource FlowMutedTextStyle}" />
            </StackPanel>
            <ToggleSwitch
                x:Name="EnabledToggle" Style="{StaticResource FlowToggleSwitchStyle}" AutomationProperties.Name="启用配置"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Right"
                IsOn="{Binding Enabled, Mode=TwoWay}" />
        </Grid>

        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <StackPanel Spacing="6">
            <TextBlock Text="默认输入法" FontWeight="SemiBold" />
            <ComboBox
                MinHeight="40"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="输入法"
                ItemsSource="{Binding ProviderOptions}"
                DisplayMemberPath="Label"
                SelectedValuePath="ProviderId"
                SelectedValue="{Binding SelectedProviderId, Mode=TwoWay}"
                IsEnabled="{Binding Enabled}" />
        </StackPanel>

        <StackPanel Spacing="6">
            <TextBlock Text="默认输入状态" FontWeight="SemiBold" />
            <ComboBox
                MinHeight="40"
                HorizontalAlignment="Stretch"
                AutomationProperties.Name="输入状态"
                ItemsSource="{Binding ActionOptions}"
                DisplayMemberPath="Label"
                SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                IsEnabled="{Binding Enabled}" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
