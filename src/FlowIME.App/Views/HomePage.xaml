<Page
    x:Class="FlowIME.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:FlowIME.App.Layout"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">

    <ScrollViewer MaxWidth="{StaticResource FlowPageContentMaxWidth}" HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        HorizontalContentAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="StructureStates">
                <VisualState x:Name="CompactStructure">
                    <VisualState.StateTriggers>
                        <layout:ContentWidthTrigger TargetElement="{x:Bind PageContent}" MinWidth="0" MaxWidth="780" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AutomationControl.(Grid.Row)" Value="1" />
                        <Setter Target="AutomationControl.(Grid.Column)" Value="0" />
                        <Setter Target="AutomationControl.Margin" Value="0,14,0,0" />
                        <Setter Target="AutomationControl.HorizontalAlignment" Value="Left" />

                        <Setter Target="HeroDivider.Visibility" Value="Collapsed" />
                        <Setter Target="DecisionWhyButton.(Grid.Row)" Value="1" />
                        <Setter Target="DecisionWhyButton.(Grid.Column)" Value="0" />
                        <Setter Target="HeroDividerColumn.Width" Value="0" />
                        <Setter Target="HeroInputColumn.Width" Value="0" />
                        <Setter Target="HeroInputSummary.(Grid.Row)" Value="1" />
                        <Setter Target="HeroInputSummary.(Grid.Column)" Value="0" />
                        <Setter Target="HeroInputSummary.(Grid.ColumnSpan)" Value="4" />
                        <Setter Target="HeroInputSummary.Margin" Value="0,18,0,0" />
                        <Setter Target="HeroInputSummary.Padding" Value="0,18,0,0" />
                        <Setter Target="HeroInputSummary.BorderThickness" Value="0,1,0,0" />

                        <Setter Target="QuickActions.Orientation" Value="Vertical" />
                        <Setter Target="QuickActions.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="CreateRuleButton.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="ManageRulesButton.HorizontalAlignment" Value="Stretch" />
                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="DesktopStructure">
                    <VisualState.StateTriggers>
                        <layout:ContentWidthTrigger TargetElement="{x:Bind PageContent}" MinWidth="780" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AutomationControl.(Grid.Row)" Value="0" />
                        <Setter Target="AutomationControl.(Grid.Column)" Value="1" />
                        <Setter Target="AutomationControl.Margin" Value="0" />
                        <Setter Target="AutomationControl.HorizontalAlignment" Value="Right" />

                        <Setter Target="HeroDivider.Visibility" Value="Visible" />
                        <Setter Target="DecisionWhyButton.(Grid.Row)" Value="0" />
                        <Setter Target="DecisionWhyButton.(Grid.Column)" Value="1" />
                        <Setter Target="HeroDividerColumn.Width" Value="32" />
                        <Setter Target="HeroInputColumn.Width" Value="240" />
                        <Setter Target="HeroInputSummary.(Grid.Row)" Value="0" />
                        <Setter Target="HeroInputSummary.(Grid.Column)" Value="3" />
                        <Setter Target="HeroInputSummary.(Grid.ColumnSpan)" Value="1" />
                        <Setter Target="HeroInputSummary.Margin" Value="0" />
                        <Setter Target="HeroInputSummary.Padding" Value="0" />
                        <Setter Target="HeroInputSummary.BorderThickness" Value="0" />

                        <Setter Target="QuickActions.Orientation" Value="Horizontal" />
                        <Setter Target="QuickActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="CreateRuleButton.HorizontalAlignment" Value="Left" />
                        <Setter Target="ManageRulesButton.HorizontalAlignment" Value="Left" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="SpacingStates">
                <VisualState x:Name="CompactSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,20,16,28" />


                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="24,28,24,36" />


                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="32,32,32,44" />


                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel
            x:Name="PageContent"

            Padding="16,20,16,28"
            Spacing="22"
            HorizontalAlignment="Stretch">

            <Grid ColumnSpacing="24" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="5">
                    <TextBlock Text="首页" Style="{StaticResource FlowPageTitleStyle}" />
                    <TextBlock
                        Text="根据当前使用场景，自动切换到合适的输入状态。"
                        Style="{StaticResource FlowPageSubtitleStyle}" />
                </StackPanel>

                <Grid
                    x:Name="AutomationControl"
                    Grid.Column="1"
                    ColumnSpacing="12"
                    VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="1" VerticalAlignment="Center">
                        <TextBlock Text="自动切换" FontWeight="SemiBold" />
                        <TextBlock
                            Text="{Binding AutomationStateLabel}"
                            FontSize="12"
                            Style="{StaticResource FlowTertiaryTextStyle}" />
                    </StackPanel>
                    <ToggleSwitch
                        x:Name="AutomationToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="自动切换"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        IsOn="{Binding IsAutomationEnabled, Mode=TwoWay}"
                        OnContent="{x:Null}"
                        OffContent="{x:Null}"
                        Toggled="AutomationToggle_Toggled" />
                </Grid>
            </Grid>

            <InfoBar
                x:Name="HomeFeedbackBar"
                Visibility="Collapsed"
                Closed="HomeFeedbackBar_Closed"
                IsOpen="False"
                IsClosable="True"
                Severity="Informational" />

            <Border Style="{StaticResource FlowHeroCardStyle}" Padding="24">
                <Grid x:Name="HeroGrid" RowSpacing="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition x:Name="HeroDividerColumn" Width="0" />
                        <ColumnDefinition x:Name="HeroInputColumn" Width="0" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="56"
                        Height="56"
                        CornerRadius="15"
                        Background="{ThemeResource FlowInsetBackgroundBrush}"
                        VerticalAlignment="Top">
                        <Grid>
                            <FontIcon
                                x:Name="CurrentAppFallbackIcon"
                                Glyph="&#xE7C3;"
                                FontSize="23"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                            <Image
                                x:Name="CurrentAppImage"
                                Width="42"
                                Height="42"
                                Stretch="Uniform"
                                Visibility="Collapsed"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock
                                Text="当前应用"
                                Style="{StaticResource FlowMutedTextStyle}"
                                VerticalAlignment="Center" />
                            <Border Style="{StaticResource FlowStatusPillStyle}">
                                <TextBlock
                                    Text="{Binding CurrentContextLabel}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            Text="{Binding CurrentApplicationName}"
                            ToolTipService.ToolTip="{Binding CurrentProcessName}"
                            FontSize="24"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap" />
<TextBlock
                            Text="{Binding CurrentContextDescription}"
                            Style="{StaticResource FlowMutedTextStyle}" />
                    </StackPanel>

                    <Border
                        x:Name="HeroDivider"
                        Grid.Column="2"
                        Width="1"
                        Margin="16,2"
                        Background="{ThemeResource FlowCardBorderBrush}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Visibility="Collapsed" />

                    <Border
                        x:Name="HeroInputSummary"
                        Grid.Column="3"
                        BorderBrush="{ThemeResource FlowCardBorderBrush}">
                        <Grid ColumnSpacing="14" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="46"
                                Height="46"
                                CornerRadius="12"
                                Background="{ThemeResource FlowAccentSoftBrush}"
                                VerticalAlignment="Center">
                                <FontIcon
                                    Glyph="&#xE765;"
                                    FontSize="20"
                                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="当前输入" Style="{StaticResource FlowSectionLabelStyle}" />
                                <TextBlock
                                    Text="{Binding CurrentInputHeadline}"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Text="{Binding CurrentInputDetail}"
                                    FontSize="12"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <StackPanel x:Name="QuickActions" Orientation="Vertical" Spacing="8">
                <Button
                    x:Name="CreateRuleButton"
                    Style="{StaticResource FlowPrimaryButtonStyle}"
                    IsEnabled="{Binding CanCreateRuleForCurrentApplication}"
                    Click="CreateCurrentRule_Click">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                        <TextBlock Text="{Binding CurrentRuleActionLabel}" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ManageRulesButton"
                    Style="{StaticResource FlowSubtleButtonStyle}"
                    Click="ManageRules_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="查看全部规则" />
                        <FontIcon Glyph="&#xE76C;" FontSize="12" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Spacing="10">
                <Grid ColumnSpacing="16" RowSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="3">
                        <TextBlock Text="当前决策" Style="{StaticResource FlowSectionTitleStyle}" />
                        <TextBlock
                            Text="FlowIME 根据以下规则确定当前输入状态。"
                            Style="{StaticResource FlowPageSubtitleStyle}" />
                    </StackPanel>
                    <Button
                        x:Name="DecisionWhyButton"
                        Grid.Column="1"
                        Style="{StaticResource FlowSubtleButtonStyle}"
                        Click="DecisionWhy_Click"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <TextBlock Text="为什么这样切换？" />
                            <FontIcon Glyph="&#xE70D;" FontSize="11" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource FlowCardStyle}">
                    <StackPanel>
                        <Border
                            Style="{StaticResource FlowDecisionRowStyle}"
                            BorderBrush="{ThemeResource FlowCardBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="依据" Style="{StaticResource FlowMutedTextStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="RuleSourceLabel"
                                    Grid.Column="2"
                                    Text="{Binding RuleSourceLabel}"
                                    Style="{StaticResource FlowDecisionValueStyle}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                            Style="{StaticResource FlowDecisionRowStyle}"
                            BorderBrush="{ThemeResource FlowCardBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE7E8;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="目标" Style="{StaticResource FlowMutedTextStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="RuleTargetLabel"
                                    Grid.Column="2"
                                    Text="{Binding RuleTargetLabel}"
                                    Style="{StaticResource FlowDecisionValueStyle}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource FlowDecisionRowStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE80F;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="场景" Style="{StaticResource FlowMutedTextStyle}" VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{Binding CurrentContextLabel}"
                                    Style="{StaticResource FlowDecisionValueStyle}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>

                        <Border
                            x:Name="DecisionExplanationPanel"
                            Visibility="Collapsed"
                            Padding="18,14"
                            Background="{ThemeResource FlowInsetBackgroundBrush}"
                            BorderBrush="{ThemeResource FlowCardBorderBrush}"
                            BorderThickness="0,1,0,0">
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding LastRuleSummary}" Style="{StaticResource FlowMutedTextStyle}" />
                                <TextBlock Text="{Binding CurrentContextDescription}" Style="{StaticResource FlowTertiaryTextStyle}" />
                                <TextBlock Text="{Binding RuleMatchReason}" Style="{StaticResource FlowTertiaryTextStyle}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
