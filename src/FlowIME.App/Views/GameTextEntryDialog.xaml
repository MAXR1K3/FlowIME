<ContentDialog
    x:Class="FlowIME.App.Views.GameTextEntryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="游戏文字输入"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    PrimaryButtonStyle="{StaticResource FlowPrimaryButtonStyle}"
    CloseButtonStyle="{StaticResource FlowSecondaryButtonStyle}"
    CornerRadius="12"
    DefaultButton="Primary"
    HorizontalContentAlignment="Stretch"
    PrimaryButtonClick="OnPrimaryButtonClick">
    <ContentDialog.Resources><ResourceDictionary Source="ms-appx:///Themes/Brand.xaml" /></ContentDialog.Resources>


    <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="DialogRoot" MaxWidth="600" Spacing="12">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="CompactWidth">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DialogRoot.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="WideWidth">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="760" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="DialogRoot.HorizontalAlignment" Value="Stretch" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>


            <Grid ColumnSpacing="16" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="3">
                    <TextBlock Text="启用此游戏配置" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="停用后保留配置，不再自动切换聊天输入状态。" Style="{StaticResource FlowTertiaryTextStyle}" />
                </StackPanel>
                <ToggleSwitch x:Name="EnabledToggle" Style="{StaticResource FlowToggleSwitchStyle}" AutomationProperties.Name="启用配置" Grid.Column="1" VerticalAlignment="Center" />
            </Grid>

            <StackPanel Spacing="8">
                <TextBlock Text="检测方式" FontWeight="SemiBold" />
                <Border Style="{StaticResource FlowCardStyle}">
                    <StackPanel>
                        <Grid Padding="14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="自动识别文字输入框" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="适用于提供标准输入框的游戏。" Style="{StaticResource FlowTertiaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="StandardControlToggle" Style="{StaticResource FlowToggleSwitchStyle}" AutomationProperties.Name="自动识别文字输入框" Grid.Column="1" VerticalAlignment="Center" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="14" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <TextBlock Text="通过聊天快捷键识别" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="适用于无法自动识别的聊天框；快捷键仍会传递给游戏。" Style="{StaticResource FlowTertiaryTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="HotkeyProfileToggle" Style="{StaticResource FlowToggleSwitchStyle}" AutomationProperties.Name="通过聊天快捷键识别"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Toggled="HotkeyProfileToggle_Toggled" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border x:Name="HotkeyFields" Padding="14" Style="{StaticResource FlowInsetCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="常用按键可直接多选；只有特殊键或组合键才需要按键录入。"
                        Style="{StaticResource FlowMutedTextStyle}" />

                    <StackPanel Spacing="6">
                        <TextBlock Text="打开聊天 / 输入" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton x:Name="OpenEnterPreset" Content="Enter" Tag="enter:13" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenTPreset" Grid.Column="1" Content="T" Tag="enter:84" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenYPreset" Grid.Column="2" Content="Y" Tag="enter:89" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenUPreset" Grid.Column="3" Content="U" Tag="enter:85" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenSlashPreset" Grid.Column="4" Content="/" Tag="enter:191" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenCommaPreset" Grid.Column="5" Content="," Tag="enter:188" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="OpenPeriodPreset" Grid.Column="6" Content="." Tag="enter:190" Click="PresetGestureButton_Click" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="发送 / 关闭输入" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ToggleButton x:Name="ExitEnterPreset" Content="Enter" Tag="exit:13" Click="PresetGestureButton_Click" />
                            <ToggleButton x:Name="ExitEscapePreset" Content="Esc" Tag="exit:27" Click="PresetGestureButton_Click" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        Text="更多按键"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="点击下方相应区域，再按下实际按键；可以录入组合键。"
                        Style="{StaticResource FlowTertiaryTextStyle}" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="EnterGesturesBox"
                            Header="打开聊天 / 输入"
                            PlaceholderText="点击这里，然后按下聊天键"
                            IsReadOnly="True"
                            PreviewKeyDown="GestureBox_PreviewKeyDown" />
                        <Button
                            x:Name="ClearEnterGesturesButton"
                            Grid.Column="1"
                            Margin="0,24,0,0"
                            VerticalAlignment="Center"
                            Content="清空"
                            Click="ClearEnterGesturesButton_Click" />
                    </Grid>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="ExitGesturesBox"
                            Header="发送 / 关闭输入"
                            PlaceholderText="点击这里，然后按下发送或取消键"
                            IsReadOnly="True"
                            PreviewKeyDown="GestureBox_PreviewKeyDown" />
                        <Button
                            x:Name="ClearExitGesturesButton"
                            Grid.Column="1"
                            Margin="0,24,0,0"
                            VerticalAlignment="Center"
                            Content="清空"
                            Click="ClearExitGesturesButton_Click" />
                    </Grid>

                    <TextBlock
                        Text="组合键请一起按下，例如 Ctrl + Y。已录入的键不会拦截游戏。"
                        FontSize="12"
                        Style="{StaticResource FlowTertiaryTextStyle}" />
                </StackPanel>
            </Border>

            <ComboBox
                MinHeight="40"
                x:Name="TargetCombo"
                Header="文字输入时使用"
                HorizontalAlignment="Stretch" />

            <InfoBar
                x:Name="ValidationBar"
                IsOpen="False"
                IsClosable="False"
                Severity="Error"
                Title="无法保存" />

            <Button
                x:Name="DeleteProfileButton"
                HorizontalAlignment="Left"
                Content="删除此游戏配置"
                Click="DeleteProfileButton_Click" />
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
