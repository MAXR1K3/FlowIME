<Page
    x:Class="FlowIME.App.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="using:FlowIME.App.Layout"
    Loaded="SettingsPage_Loaded"
    Unloaded="SettingsPage_Unloaded">

    <ScrollViewer HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        HorizontalScrollMode="Disabled"
        VerticalScrollBarVisibility="Auto"
        VerticalScrollMode="Auto"
        HorizontalContentAlignment="Stretch">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="SettingsStructureStates">
                <VisualState x:Name="CompactSettingsStructure">
                    <VisualState.StateTriggers>
                        <layout:ContentWidthTrigger TargetElement="{x:Bind PageContent}" MinWidth="0" MaxWidth="620" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StartupToggle.(Grid.Row)" Value="1" />
                        <Setter Target="StartupToggle.(Grid.Column)" Value="0" />
                        <Setter Target="StartupToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="StartupToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="InputStatusOverlayToggle.(Grid.Row)" Value="1" />
                        <Setter Target="InputStatusOverlayToggle.(Grid.Column)" Value="0" />
                        <Setter Target="InputStatusOverlayToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="InputStatusOverlayToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="GameplayKeyboardBaselineToggle.(Grid.Row)" Value="1" />
                        <Setter Target="GameplayKeyboardBaselineToggle.(Grid.Column)" Value="0" />
                        <Setter Target="GameplayKeyboardBaselineToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="GameplayKeyboardBaselineToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="GameplayHotkeyGuardToggle.(Grid.Row)" Value="1" />
                        <Setter Target="GameplayHotkeyGuardToggle.(Grid.Column)" Value="0" />
                        <Setter Target="GameplayHotkeyGuardToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="GameplayHotkeyGuardToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="WinSpaceToggle.(Grid.Row)" Value="1" />
                        <Setter Target="WinSpaceToggle.(Grid.Column)" Value="0" />
                        <Setter Target="WinSpaceToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="WinSpaceToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="CtrlSpaceToggle.(Grid.Row)" Value="1" />
                        <Setter Target="CtrlSpaceToggle.(Grid.Column)" Value="0" />
                        <Setter Target="CtrlSpaceToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="CtrlSpaceToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="LegacyHotkeyToggle.(Grid.Row)" Value="1" />
                        <Setter Target="LegacyHotkeyToggle.(Grid.Column)" Value="0" />
                        <Setter Target="LegacyHotkeyToggle.Margin" Value="0,10,0,0" />
                        <Setter Target="LegacyHotkeyToggle.HorizontalAlignment" Value="Left" />

                        <Setter Target="GameTextEntryActions.(Grid.Row)" Value="1" />
                        <Setter Target="GameTextEntryActions.(Grid.Column)" Value="0" />
                        <Setter Target="GameTextEntryActions.Margin" Value="0,12,0,0" />
                        <Setter Target="GameTextEntryActions.HorizontalAlignment" Value="Left" />
                        <Setter Target="GameLibraryList.(Grid.Row)" Value="2" />

                        <Setter Target="CopyDiagnosticsButton.(Grid.Row)" Value="1" />
                        <Setter Target="CopyDiagnosticsButton.(Grid.Column)" Value="0" />
                        <Setter Target="CopyDiagnosticsButton.Margin" Value="0,12,0,0" />
                        <Setter Target="CopyDiagnosticsButton.HorizontalAlignment" Value="Left" />

                    </VisualState.Setters>
                </VisualState>

                <VisualState x:Name="DesktopSettingsStructure">
                    <VisualState.StateTriggers>
                        <layout:ContentWidthTrigger TargetElement="{x:Bind PageContent}" MinWidth="620" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="StartupToggle.(Grid.Row)" Value="0" />
                        <Setter Target="StartupToggle.(Grid.Column)" Value="1" />
                        <Setter Target="StartupToggle.Margin" Value="0" />
                        <Setter Target="StartupToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="InputStatusOverlayToggle.(Grid.Row)" Value="0" />
                        <Setter Target="InputStatusOverlayToggle.(Grid.Column)" Value="1" />
                        <Setter Target="InputStatusOverlayToggle.Margin" Value="0" />
                        <Setter Target="InputStatusOverlayToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="GameplayKeyboardBaselineToggle.(Grid.Row)" Value="0" />
                        <Setter Target="GameplayKeyboardBaselineToggle.(Grid.Column)" Value="1" />
                        <Setter Target="GameplayKeyboardBaselineToggle.Margin" Value="0" />
                        <Setter Target="GameplayKeyboardBaselineToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="GameplayHotkeyGuardToggle.(Grid.Row)" Value="0" />
                        <Setter Target="GameplayHotkeyGuardToggle.(Grid.Column)" Value="1" />
                        <Setter Target="GameplayHotkeyGuardToggle.Margin" Value="0" />
                        <Setter Target="GameplayHotkeyGuardToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="WinSpaceToggle.(Grid.Row)" Value="0" />
                        <Setter Target="WinSpaceToggle.(Grid.Column)" Value="1" />
                        <Setter Target="WinSpaceToggle.Margin" Value="0" />
                        <Setter Target="WinSpaceToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="CtrlSpaceToggle.(Grid.Row)" Value="0" />
                        <Setter Target="CtrlSpaceToggle.(Grid.Column)" Value="1" />
                        <Setter Target="CtrlSpaceToggle.Margin" Value="0" />
                        <Setter Target="CtrlSpaceToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="LegacyHotkeyToggle.(Grid.Row)" Value="0" />
                        <Setter Target="LegacyHotkeyToggle.(Grid.Column)" Value="1" />
                        <Setter Target="LegacyHotkeyToggle.Margin" Value="0" />
                        <Setter Target="LegacyHotkeyToggle.HorizontalAlignment" Value="Right" />

                        <Setter Target="GameTextEntryActions.(Grid.Row)" Value="0" />
                        <Setter Target="GameTextEntryActions.(Grid.Column)" Value="1" />
                        <Setter Target="GameTextEntryActions.Margin" Value="0" />
                        <Setter Target="GameTextEntryActions.HorizontalAlignment" Value="Right" />
                        <Setter Target="GameLibraryList.(Grid.Row)" Value="1" />

                        <Setter Target="CopyDiagnosticsButton.(Grid.Row)" Value="0" />
                        <Setter Target="CopyDiagnosticsButton.(Grid.Column)" Value="1" />
                        <Setter Target="CopyDiagnosticsButton.Margin" Value="0" />
                        <Setter Target="CopyDiagnosticsButton.HorizontalAlignment" Value="Right" />

                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>

            <VisualStateGroup x:Name="SettingsSpacingStates">
                <VisualState x:Name="CompactSettingsSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="16,20,16,28" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="ComfortableSettingsSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="24,24,24,32" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideSettingsSpacing">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1100" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="PageContent.Padding" Value="32,28,32,40" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <StackPanel x:Name="PageContent" MaxWidth="{StaticResource FlowPageContentMaxWidth}" Padding="16,20,16,28" Spacing="20" HorizontalAlignment="Stretch">
            <StackPanel Spacing="5">
                <TextBlock x:Name="PageTitle" Text="设置" Style="{StaticResource FlowPageTitleStyle}" />
                <TextBlock
                    x:Name="PageSubtitle"
                    Text="控制启动、状态提示与诊断行为。"
                    Style="{StaticResource FlowPageSubtitleStyle}" />
            </StackPanel>


            <StackPanel x:Name="GeneralSection" Spacing="10">
                <TextBlock Text="常规" Style="{StaticResource FlowSectionTitleStyle}" />
                <Border Style="{StaticResource FlowCardStyle}">
                    <StackPanel>
                        <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="随 Windows 登录启动" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="StartupStatusText"
                                    Text="登录后在后台启动，不弹出主窗口。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="StartupToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="随 Windows 登录启动"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Toggled="StartupToggle_Toggled" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="记住每个应用的中英文状态" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="AppStateMemoryStatusText"
                                    Text="回到应用时恢复离开前的中文或英文；首次进入仍按全局默认。只作用于没有专属规则的应用。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="AppStateMemoryToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="记住每个应用的中英文状态"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Toggled="AppStateMemoryToggle_Toggled" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <!-- Always-on behavior: stated as a fact, not shown as a locked switch. -->
                        <Grid Padding="18" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon
                                Glyph="&#xE946;"
                                FontSize="16"
                                Margin="0,2,0,0"
                                VerticalAlignment="Top"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="关闭主窗口后 FlowIME 会继续在系统托盘运行；从托盘菜单选择“退出”才会结束。"
                                Style="{StaticResource FlowMutedTextStyle}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="OverlaySection" Spacing="10">
                <TextBlock Text="状态提示" Style="{StaticResource FlowSectionTitleStyle}" />
                <Border Style="{StaticResource FlowCardStyle}">
                    <StackPanel>
                        <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="输入状态浮层" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="InputStatusOverlayStatusText"
                                    Text="状态变化时显示中 / EN / US；游戏中的 US 状态保持可见。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="InputStatusOverlayToggle"
                                Style="{StaticResource FlowToggleSwitchStyle}"
                                AutomationProperties.Name="输入状态浮层"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Toggled="InputStatusOverlayToggle_Toggled" />
                        </Grid>

                        <Rectangle Height="1" Margin="18,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <StackPanel x:Name="InputStatusOverlayPersonalizationPanel" Padding="18" Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock Text="外观与位置" FontWeight="SemiBold" />
                                <TextBlock Text="选择屏幕固定位置，或让浮层跟随当前输入光标；应用未公开光标位置时自动回到底部居中。" Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>

                            <Grid ColumnSpacing="18" RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="220" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="显示位置" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="InputStatusOverlayPositionComboBox"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="浮层显示位置"
                                    SelectionChanged="InputStatusOverlayPreference_Changed">
                                    <ComboBoxItem Content="跟随输入光标" />
                                    <ComboBoxItem Content="左上角" />
                                    <ComboBoxItem Content="顶部居中" />
                                    <ComboBoxItem Content="右上角" />
                                    <ComboBoxItem Content="屏幕中央" />
                                    <ComboBoxItem Content="左下角" />
                                    <ComboBoxItem Content="底部居中" />
                                    <ComboBoxItem Content="右下角" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Text="浮层大小" VerticalAlignment="Center" />
                                <ComboBox
                                    x:Name="InputStatusOverlaySizeComboBox"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.Name="浮层大小"
                                    SelectionChanged="InputStatusOverlayPreference_Changed">
                                    <ComboBoxItem Content="小" />
                                    <ComboBoxItem Content="中" />
                                    <ComboBoxItem Content="大" />
                                </ComboBox>

                                <StackPanel Grid.Row="2" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="不透明度" />
                                    <TextBlock x:Name="InputStatusOverlayOpacityText" Text="100%" Style="{StaticResource FlowMutedTextStyle}" />
                                </StackPanel>
                                <Slider
                                    x:Name="InputStatusOverlayOpacitySlider"
                                    Grid.Row="2"
                                    Grid.Column="1"
                                    Minimum="40"
                                    Maximum="100"
                                    StepFrequency="1"
                                    AutomationProperties.Name="浮层不透明度"
                                    ValueChanged="InputStatusOverlayOpacitySlider_ValueChanged" />

                                <StackPanel Grid.Row="3" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="平滑动效" />
                                    <TextBlock Text="淡入淡出并轻微位移；关闭后立即显示。" Style="{StaticResource FlowMutedTextStyle}" />
                                </StackPanel>
                                <ToggleSwitch
                                    x:Name="InputStatusOverlayAnimationsToggle"
                                    Grid.Row="3"
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    Style="{StaticResource FlowToggleSwitchStyle}"
                                    AutomationProperties.Name="浮层平滑动效"
                                    Toggled="InputStatusOverlayPreference_Changed" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="GameProtectionSection" Spacing="10" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="游戏保护" Style="{StaticResource FlowSectionTitleStyle}" />
                    <TextBlock
                        Text="游戏时保持 US 键盘并阻止输入法快捷键误触；离开游戏后自动恢复。"
                        Style="{StaticResource FlowMutedTextStyle}" />
                </StackPanel>

                <Border Style="{StaticResource FlowCardStyle}">
                    <StackPanel>
                        <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="游戏中使用美式键盘（US）" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="GameplayKeyboardBaselineStatusText"
                                    Text="游戏中使用美式键盘，避免中文候选框干扰操作。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="GameplayKeyboardBaselineToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="游戏中使用美式键盘"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Toggled="GameplayKeyboardBaselineToggle_Toggled" />
                        </Grid>

                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                        <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="游戏内阻止输入法快捷键" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="GameplayHotkeyStatusText"
                                    Text="只在识别到游戏场景时拦截容易误触的输入法切换组合键。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <ToggleSwitch
                                x:Name="GameplayHotkeyGuardToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="游戏内阻止输入法快捷键"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Toggled="GameplayHotkeyToggle_Toggled" />
                        </Grid>

                        <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="快捷键保护范围" IsExpanded="False">
                            <StackPanel Background="{ThemeResource FlowInsetBackgroundBrush}">
                                <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="阻止 Win + Space" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="阻止 Windows 输入语言面板在游戏中被误触。" Style="{StaticResource FlowMutedTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="WinSpaceToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="阻止 Win + Space"
                                        Grid.Column="1"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Toggled="GameplayHotkeyToggle_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="阻止 Ctrl + Space" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="阻止中 / 英文模式快捷切换在游戏中被误触。" Style="{StaticResource FlowMutedTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="CtrlSpaceToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="阻止 Ctrl + Space"
                                        Grid.Column="1"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Toggled="GameplayHotkeyToggle_Toggled" />
                                </Grid>

                                <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <Grid Padding="18" ColumnSpacing="20" RowSpacing="4">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="传统语言切换快捷键" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <Border Style="{StaticResource FlowPillStyle}">
                                                <TextBlock Text="可选" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="包括 Alt + Shift 与 Ctrl + Shift；它们可能被游戏使用，因此默认关闭。" Style="{StaticResource FlowMutedTextStyle}" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="LegacyHotkeyToggle"
                        Style="{StaticResource FlowToggleSwitchStyle}"
                        AutomationProperties.Name="传统语言切换快捷键"
                                        Grid.Column="1"
                                        IsEnabled="False"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Right"
                                        Toggled="GameplayHotkeyToggle_Toggled" />
                                </Grid>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="GameTextEntrySection" Spacing="12" Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Text="游戏文字输入库" Style="{StaticResource FlowSectionTitleStyle}" />
                    <TextBlock
                        x:Name="GameTextEntryProfileStatusText"
                        Text="集中管理每款游戏的聊天输入；扫描不会覆盖已有配置。"
                        Style="{StaticResource FlowMutedTextStyle}" />
                </StackPanel>

                <Border
                    x:Name="CurrentGameStatusCard"
                    Padding="16,14"
                    Style="{StaticResource FlowCardStyle}"
                    AutomationProperties.LiveSetting="Polite">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="CurrentGameActiveIndicator"
                                Fill="{ThemeResource FlowSuccessBrush}"
                                Visibility="Collapsed" />
                            <Ellipse
                                x:Name="CurrentGameInactiveIndicator"
                                Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CurrentGameStatusTitle"
                                Text="当前未检测到游戏"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="CurrentGameStatusDescription"
                                Text="进入游戏后会自动识别，无需手动扫描。"
                                Style="{StaticResource FlowMutedTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid ColumnSpacing="10" RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox
                        x:Name="GameLibrarySearchBox"
                        MinWidth="260"
                        HorizontalAlignment="Stretch"
                        VerticalContentAlignment="Center"
                        PlaceholderText="搜索游戏"
                        QueryIcon="Find"
                        TextChanged="GameLibrarySearchBox_TextChanged"
                        AutomationProperties.Name="搜索游戏库" />
                    <StackPanel
                        x:Name="GameTextEntryActions"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Right">
                        <Button
                            x:Name="ScanGameLibraryButton"
                            Style="{StaticResource FlowSecondaryButtonStyle}"
                            Content="扫描"
                            ToolTipService.ToolTip="重新扫描 Steam 和 Epic 本地游戏库"
                            Click="ScanGameLibraryButton_Click" />
                        <Button
                            x:Name="AddGameTextEntryButton"
                            Style="{StaticResource FlowPrimaryButtonStyle}"
                            Content="添加游戏…"
                            Click="AddGameTextEntryButton_Click" />
                    </StackPanel>

                    <ListView
                        x:Name="GameLibraryList"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        SelectionMode="None"
                        IsItemClickEnabled="False"
                        AutomationProperties.Name="游戏输入库">
                        <ListView.Resources>
                            <!-- Shortcut keys drawn as keycaps. -->
                            <DataTemplate x:Key="GameKeycapTemplate">
                                <Border
                                    MinWidth="28"
                                    Height="22"
                                    Padding="7,0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1,1,1,2"
                                    CornerRadius="4">
                                    <TextBlock
                                        Text="{Binding}"
                                        FontSize="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                                </Border>
                            </DataTemplate>
                            <ItemsPanelTemplate x:Key="GameKeycapPanel">
                                <StackPanel Orientation="Horizontal" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FlowRuleListItemStyle}">
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Padding="16,12"
                                    Background="{ThemeResource FlowCardBackgroundBrush}"
                                    BorderBrush="{ThemeResource FlowCardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <Grid ColumnSpacing="16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Game artwork, or a quiet controller tile when there is none. -->
                                        <Border
                                            Width="44"
                                            Height="44"
                                            VerticalAlignment="Center"
                                            CornerRadius="8"
                                            Background="{ThemeResource FlowInsetBackgroundBrush}">
                                            <Grid>
                                                <FontIcon
                                                    Glyph="&#xE7FC;"
                                                    FontSize="20"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                                <Image Source="{Binding Icon}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock TextWrapping="Wrap">
                                                <Run Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" />
                                                <Run Text="   " FontSize="12" />
                                                <Run
                                                    Text="{Binding MetaLabel}"
                                                    FontSize="12"
                                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </TextBlock>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock
                                                    Text="打开"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsControl
                                                    ItemsSource="{Binding EnterKeys}"
                                                    ItemTemplate="{StaticResource GameKeycapTemplate}"
                                                    ItemsPanel="{StaticResource GameKeycapPanel}"
                                                    IsTabStop="False" />
                                                <TextBlock
                                                    Margin="10,0,0,0"
                                                    Text="发送 / 取消"
                                                    FontSize="12"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <ItemsControl
                                                    ItemsSource="{Binding ExitKeys}"
                                                    ItemTemplate="{StaticResource GameKeycapTemplate}"
                                                    ItemsPanel="{StaticResource GameKeycapPanel}"
                                                    IsTabStop="False" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Chat state, aligned in one column so the list scans top to bottom. -->
                                        <Grid Grid.Column="2" Width="112" VerticalAlignment="Center">
                                            <Border
                                                HorizontalAlignment="Left"
                                                Padding="8,3,10,3"
                                                CornerRadius="4"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}"
                                                Visibility="{Binding SuccessToneVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                                    <TextBlock Text="{Binding StatusChipLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Left"
                                                Padding="8,3,10,3"
                                                CornerRadius="4"
                                                Background="{ThemeResource FlowInsetBackgroundBrush}"
                                                Visibility="{Binding NeutralToneVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center" Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                                                    <TextBlock
                                                        Text="{Binding StatusChipLabel}"
                                                        FontSize="12"
                                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                            </Border>
                                            <Border
                                                HorizontalAlignment="Left"
                                                Padding="7,3,10,3"
                                                CornerRadius="4"
                                                Background="{ThemeResource SystemFillColorCautionBackgroundBrush}"
                                                Visibility="{Binding CautionToneVisibility}">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <FontIcon
                                                        Glyph="&#xE7BA;"
                                                        FontSize="12"
                                                        VerticalAlignment="Center"
                                                        Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                                                    <TextBlock Text="{Binding StatusChipLabel}" FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <Button
                                            Grid.Column="3"
                                            MinHeight="32"
                                            Padding="12,5"
                                            CornerRadius="6"
                                            VerticalAlignment="Center"
                                            Content="配置"
                                            Click="ConfigureGameLibraryItemButton_Click" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </StackPanel>

            <StackPanel x:Name="DiagnosticsSection" Spacing="10">
                <TextBlock Text="高级" Style="{StaticResource FlowSectionTitleStyle}" />
                <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Header="诊断与排错" IsExpanded="False">
                    <Border Padding="18" Background="{ThemeResource FlowCardBackgroundBrush}" BorderBrush="{ThemeResource FlowCardBorderBrush}" BorderThickness="1" CornerRadius="0,0,12,12">
                        <Grid ColumnSpacing="20" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="3" VerticalAlignment="Center">
                                <TextBlock Text="诊断信息" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DiagnosticsStatusText"
                                    Text="复制当前运行状态、规则恢复状态与日志信息；不包含键入内容或剪贴板。"
                                    Style="{StaticResource FlowMutedTextStyle}" />
                            </StackPanel>
                            <Button
                                x:Name="CopyDiagnosticsButton"
                                Grid.Column="1"
                                Style="{StaticResource FlowSecondaryButtonStyle}"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Right"
                                Content="复制诊断信息"
                                Click="CopyDiagnosticsButton_Click" />
                        </Grid>
                    </Border>
                </Expander>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
